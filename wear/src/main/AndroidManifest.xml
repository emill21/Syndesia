<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Browse the watch's storage to send files to the phone (granted by the phone over ADB at setup). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Installs APKs sent over Bluetooth (the watch asks you to confirm each one). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Granted once by the phone over ADB (pm grant), so the helper can switch Wireless debugging back on. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Open Arkheia on the phone's files. -->
    <queries>
        <package android:name="com.arkheia.app" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".WearActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ComputerActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".ComputerPadActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Syndesia.NoSwipe" />
        <activity
            android:name=".AirSettingsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".ComputerKeysActivity"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".MouseKeeper"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:taskAffinity="" />
        <!-- Touchpad: no swipe-to-dismiss, so dragging right moves the cursor instead of closing. -->
        <activity
            android:name=".MouseActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Syndesia.NoSwipe" />
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".TypeActivity"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FilesActivity"
            android:exported="false"
            android:taskAffinity="" />

        <!-- Messages from Syndesia on the phone, over Bluetooth. -->
        <service
            android:name=".WakeListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/syndesia" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/syndesia" />
            </intent-filter>
        </service>

        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <service
            android:name=".WifiKeeper"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- The phone's files, for Arkheia. Callers are checked by package. -->
        <provider
            android:name=".PhoneFilesProvider"
            android:authorities="com.syndesia.app.phonefiles"
            android:exported="true" />
    </application>
</manifest>
